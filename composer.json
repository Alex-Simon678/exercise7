{
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.0"
    },
    "scripts": {
        "cs-dry-run": "php-cs-fixer fix . --dry-run --diff",
        "cs-fix": "php-cs-fixer fix .",
        "analyse": "phpstan analyse",
        "check-all": [
            "@cs-fix",
            "@analyse"
        ]
    }
}